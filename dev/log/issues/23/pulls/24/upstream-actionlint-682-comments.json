com/kolyshkin","followers_url":"https://api.github.com/users/kolyshkin/followers","following_url":"https://api.github.com/users/kolyshkin/following{/other_user}","gists_url":"https://api.github.com/users/kolyshkin/gists{/gist_id}","starred_url":"https://api.github.com/users/kolyshkin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kolyshkin/subscriptions","organizations_url":"https://api.github.com/users/kolyshkin/orgs","repos_url":"https://api.github.com/users/kolyshkin/repos","events_url":"https://api.github.com/users/kolyshkin/events{/privacy}","received_events_url":"https://api.github.com/users/kolyshkin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-28T17:59:50Z","updated_at":"2026-10-28T21:15:01Z","body":"@JayDoubleu I suggest you to switch to the fork at https://github.com/kjanat/actionlint which fixes many issues found here (and keeps maintaining the scripts).","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6476645746/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6480731810","html_url":"https://github.com/rhysd/actionlint/issues/682#issuecomment-6480731810","issue_url":"https://api.github.com/repos/rhysd/actionlint/issues/682","id":6480731810,"node_id":"IC_kwDOFhfz288AAAABgkgeog","user":{"login":"konard","id":1431904,"node_id":"MDQ6VXNlcjE0MzE5MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/1431904?v=4","gravatar_id":"","url":"https://api.github.com/users/konard","html_url":"https://github.com/konard","followers_url":"https://api.github.com/users/konard/followers","following_url":"https://api.github.com/users/konard/following{/other_user}","gists_url":"https://api.github.com/users/konard/gists{/gist_id}","starred_url":"https://api.github.com/users/konard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/konard/subscriptions","organizations_url":"https://api.github.com/users/konard/orgs","repos_url":"https://api.github.com/users/konard/repos","events_url":"https://api.github.com/users/konard/events{/privacy}","received_events_url":"https://api.github.com/users/konard/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-28T21:08:41Z","updated_at":"2026-10-28T21:08:41Z","body":"Revalidated against current actionlint 1.7.12 while updating https://github.com/link-foundation/meta-sovereign/pull/51 on 2026-10-28. `ubuntu-26.04` and `ubuntu-26.04-arm` still produce `label ... is unknown`. The same registry gap affects `windows-11-vs2026-arm`, now listed in https://github.com/actions/runner-images#available-images.\n\nMinimal repro: a workflow with `on: push`, one job using `runs-on: ubuntu-26.04` (repeat for the other two labels), and `steps: [{run: echo ok}]`; run actionlint 1.7.12. Locally reproduced all three errors. Our consumer uses the documented narrow workaround:\n\n```yaml\nself-hosted-runner:\n  labels:\n    - ubuntu-26.04\n    - ubuntu-26.04-arm\n    - windows-11-vs2026-arm\n```\n\nThis permits only the verified hosted labels and keeps other workflow validation enabled. Suggested upstream change: add these three labels to the built-in runner-label table and its tests, then release the validator. Linking here rather than opening another duplicate of #682.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6480731810/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6480859556","html_url":"https://github.com/rhysd/actionlint/issues/682#issuecomment-6480859556","issue_url":"https://api.github.com/repos/rhysd/actionlint/issues/682","id":6480859556,"node_id":"IC_kwDOFhfz288AAAABgkoRpA","user":{"login":"kolyshkin","id":4522509,"node_id":"MDQ6VXNlcjQ1MjI1MDk=","avatar_url":"https://avatars.githubusercontent.com/u/4522509?v=4","gravatar_id":"","url":"https://api.github.com/users/kolyshkin","html_url":"https://github.com/kolyshkin","followers_url":"https://api.github.com/users/kolyshkin/followers","following_url":"https://api.github.com/users/kolyshkin/following{/other_user}","gists_url":"https://api.github.com/users/kolyshkin/gists{/gist_id}","starred_url":"https://api.github.com/users/kolyshkin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kolyshkin/subscriptions","organizations_url":"https://api.github.com/users/kolyshkin/orgs","repos_url":"https://api.github.com/users/kolyshkin/repos","events_url":"https://api.github.com/users/kolyshkin/events{/privacy}","received_events_url":"https://api.github.com/users/kolyshkin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-28T21:14:53Z","updated_at":"2026-10-28T21:14:53Z","body":"> 26\\. Revalidated against current actionlint 1.7.12 while updating [link-foundation/meta-sovereign#51](https://github.com/link-foundation/meta-sovereign/pull/51) on 2026-10-28. `ubuntu-26.04` and `ubuntu-26.04-arm` still produce `label ... is unknown`. The same registry gap affects `windows-11-vs2026-arm`, now listed in https://github.com/actions/runner-images#available-images.\n>      Minimal repro: a workflow with `on: push`, one job using `runs-on: ubuntu-26.04` (repeat for the other two labels), and `steps: [{run: echo ok}]`; run actionlint 1.7.12. Locally reproduced all three errors. Our consumer uses the documented narrow workaround:\n>      self-hosted-runner:\n>        labels:\n>          - ubuntu-26.04\n>          - ubuntu-26.04-arm\n>          - windows-11-vs2026-arm\n>          \n>            \n>          \n>      \n>            \n>          \n>      \n>          \n>        \n>      This permits only the verified hosted labels and keeps other workflow validation enabled. Suggested upstream change: add these three labels to the built-in runner-label table and its tests, then release the validator. Linking here rather than opening another duplicate of [#682](https://github.com/rhysd/actionlint/issues/682).\n\nThis repo is no longer maintained; I suggest you to switch to the fork at https://github.com/kjanat/actionlint which fixes many issues found here (and keeps maintaining the scripts).","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6480859556/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6672589148","html_url":"https://github.com/rhysd/actionlint/issues/682#issuecomment-6672589148","issue_url":"https://api.github.com/repos/rhysd/actionlint/issues/682","id":6672589148,"node_id":"IC_kwDOFhfz288AAAABjbehXA","user":{"login":"konard","id":1431904,"node_id":"MDQ6VXNlcjE0MzE5MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/1431904?v=4","gravatar_id":"","url":"https://api.github.com/users/konard","html_url":"https://github.com/konard","followers_url":"https://api.github.com/users/konard/followers","following_url":"https://api.github.com/users/konard/following{/other_user}","gists_url":"https://api.github.com/users/konard/gists{/gist_id}","starred_url":"https://api.github.com/users/konard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/konard/subscriptions","organizations_url":"https://api.github.com/users/konard/orgs","repos_url":"https://api.github.com/users/konard/repos","events_url":"https://api.github.com/users/konard/events{/privacy}","received_events_url":"https://api.github.com/users/konard/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-11-05T23:48:28Z","updated_at":"2026-11-05T23:48:28Z","body":"Reproduced with the current released actionlint 1.7.12 (official image digest b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667): a minimal job with `runs-on: ubuntu-26.04` fails with `label \"ubuntu-26.04\" is unknown`. This hosted runner has been GA since September 17, 2026: https://github.blog/changelog/2026-09-17-ubuntu-26-generally-available-and-latest-migration/ .\n\nThe downstream workaround in https://github.com/linksplatform/Data.Doublets/pull/557 uses the existing supported actionlint.yaml `self-hosted-runner.labels: [ubuntu-26.04]` configuration to extend known labels while retaining other syntax, expression and embedded ShellCheck/Pyflakes checks. The runner remains GitHub-hosted. Please add the label to the built-in runner schema and release the update (the existing related PRs appear to contain the necessary change).\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6672589148/reactions","total_count":4,"+1":0,"-1":4,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6673108486","html_url":"https://github.com/rhysd/actionlint/issues/682#issuecomment-6673108486","issue_url":"https://api.github.com/repos/rhysd/actionlint/issues/682","id":6673108486,"node_id":"IC_kwDOFhfz288AAAABjb-OBg","user":{"login":"jrfnl","id":663378,"node_id":"MDQ6VXNlcjY2MzM3OA==","avatar_url":"https://avatars.githubusercontent.com/u/663378?v=4","gravatar_id":"","url":"https://api.github.com/users/jrfnl","html_url":"https://github.com/jrfnl","followers_url":"https://api.github.com/users/jrfnl/followers","following_url":"https://api.github.com/users/jrfnl/following{/other_user}","gists_url":"https://api.github.com/users/jrfnl/gists{/gist_id}","starred_url":"https://api.github.com/users/jrfnl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jrfnl/subscriptions","organizations_url":"https://api.github.com/users/jrfnl/orgs","repos_url":"https://api.github.com/users/jrfnl/repos","events_url":"https://api.github.com/users/jrfnl/events{/privacy}","received_events_url":"https://api.github.com/users/jrfnl/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-11-06T00:20:45Z","updated_at":"2026-11-06T00:20:45Z","body":"@konard Please don't use the mansplaining machine to post low quality comments, reiterating what everyone already knows.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6673108486/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]