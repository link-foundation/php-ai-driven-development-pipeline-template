{
  "threshold": 0,
  "minTokens": 30,
  "minLines": 5,
  "ignore": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/*.min.js",
    "**/coverage/**",
    "**/.changeset/**",
    "**/docs/case-studies/**/data/**",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/reports/**",
    "**/out/**"
  ],
  "reporters": ["console", "html"],
  "output": "./reports/jscpd",
  "mode": "weak"
}
