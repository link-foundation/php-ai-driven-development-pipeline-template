{
  "name": "@link-foundation/example-package-name",
  "version": "0.11.4",
  "description": "A JavaScript/TypeScript package template for AI-driven development",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "example-package-name": "./bin/example-package-name.js"
  },
  "files": [
    "bin/",
    "src/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 tests/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplication": "jscpd .",
    "check": "npm run lint && npm run format:check && npm run check:duplication && npm run lint:secrets",
    "example:web:dev": "npm --prefix examples/universal-app run dev",
    "example:web:build": "npm --prefix examples/universal-app run build",
    "example:web:preview": "npm --prefix examples/universal-app run preview",
    "example:web:preview-images": "node scripts/update-preview-images.mjs",
    "example:desktop:package": "npm --prefix examples/universal-app run desktop:package",
    "example:desktop:make": "npm --prefix examples/universal-app run desktop:make",
    "example:mobile:sync": "npm --prefix examples/universal-app run mobile:sync",
    "prepare": "husky",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main",
    "lint:secrets": "secretlint \"**/*\""
  },
  "keywords": [
    "template",
    "javascript",
    "typescript",
    "ai-driven"
  ],
  "author": "",
  "license": "Unlicense",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/js-ai-driven-development-pipeline-template.git"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "browser-commander": "^0.34.1",
    "command-stream": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "lino-arguments": "^0.4.1",
    "lint-staged": "^17.6.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "secretlint": "^13.1.0",
    "semver": "^7.8.6",
    "test-anywhere": "^0.9.1",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "prettier --check"
    ],
    "*.md": [
      "prettier --write",
      "prettier --check"
    ]
  },
  "packageManager": "npm@12.2.2",
  "allowScripts": {
    "better-sqlite3@13.1.1": true,
    "node-pty@1.1.0": true
  }
}
